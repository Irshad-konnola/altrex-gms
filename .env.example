# ==============================================================================
# ALTREX GMS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file as '.env.local' and provide the real values for your environment.
# Never commit '.env.local' or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Public API Key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Secret Key (HIGH PRIVILEGE: Server actions & API routes only)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Direct Postgres connection string (required for pg_dump automated backup action)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
SUPABASE_DB_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. APPLICATION URLS
# ------------------------------------------------------------------------------
# Base URL of the web application (used for redirects, payment callbacks, and absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production URL for OpenGraph metadata and external webhooks
URL="https://altrex-gms.vercel.app"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Razorpay Key ID (rzp_test_... for sandbox, rzp_live_... for production)
RAZORPAY_KEY_ID="rzp_test_yourKeyId"

# Razorpay Secret Key
RAZORPAY_KEY_SECRET="yourRazorpaySecretKey"

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# ------------------------------------------------------------------------------
# 4. META WHATSAPP CLOUD API (Automations & Notifications)
# ------------------------------------------------------------------------------
# Permanent System User Access Token from Meta Developer Portal
WHATSAPP_ACCESS_TOKEN="EAA..."

# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"

# Webhook Verify Token (custom secret configured in Meta Developer Webhook setup)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verification_token"

# Owner Phone Number with country code (receives daily automated business summaries)
# Example for India: +919876543210
OWNER_PHONE_NUMBER="+919876543210"

# ------------------------------------------------------------------------------
# 5. AUTOMATED CRON SECURITY
# ------------------------------------------------------------------------------
# Bearer secret required by GitHub Actions / external cron callers to trigger /api/cron/*
CRON_SECRET="your_secure_random_cron_secret"

# ------------------------------------------------------------------------------
# 6. UPSTASH REDIS (Rate Limiting & Caching - Optional)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 7. SENTRY ERROR MONITORING (Optional)
# ------------------------------------------------------------------------------
# SENTRY_AUTH_TOKEN="your_sentry_auth_token"
